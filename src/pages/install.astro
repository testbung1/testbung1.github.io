---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const KS_IMG = 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTYlk6oHRX_isIEsA0183yypCcVuMNaseuGzSymQIUY1g&s';
---

<BaseLayout
  title="Tải ESign & KSign iPA Mới Nhất - Vũ Văn Khơi (khoindvn)"
  description="Tải file cài đặt ESign và KSign iPA sạch, an toàn và mới nhất về thiết bị. Hỗ trợ ký ứng dụng iOS trực tiếp trên điện thoại tốt nhất."
  keywords="tải esign ipa, tải ksign ipa, esign ipa mới nhất, ksign ipa mới nhất, khoindvn, sideload ios, muacert"
  canonical="https://khoindvn.io.vn/install/"
  ads={true}
>
  <style slot="head">
    .ysign-hero { position: relative; padding: 5.5rem 1.25rem 4.5rem; text-align: center; background: #09090f; color: #fff; overflow: hidden; scroll-margin-top: 52px; }
    .ysign-hero::before { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.45) 0%, transparent 45%), radial-gradient(circle at 90% 80%, rgba(168, 85, 247, 0.4) 0%, transparent 45%), radial-gradient(circle at 50% 50%, rgba(52, 211, 153, 0.25) 0%, transparent 50%); filter: blur(60px); z-index: 0; transform: scale(1.1); }
    .ysign-hero-inner { position: relative; z-index: 1; max-width: 800px; margin: 0 auto; }
    .ysign-hero h1 { font-size: 2.8rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1.15; margin-bottom: 0.8rem; background: linear-gradient(135deg, #fff 30%, #a855f7 70%, #6366f1 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: titleGlow 4s ease-in-out infinite alternate; }
    @keyframes titleGlow { from { text-shadow: 0 0 20px rgba(168, 85, 247, 0); } to { text-shadow: 0 0 20px rgba(168, 85, 247, 0.2); } }
    .ysign-hero p { font-size: 1.1rem; color: rgba(255, 255, 255, 0.65); max-width: 520px; margin: 0 auto 2rem; line-height: 1.6; }
    .btn-hero-cta { display: inline-flex; align-items: center; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; font-weight: 700; font-size: 0.95rem; padding: 0.85rem 2rem; border-radius: var(--r-pill); border: none; cursor: pointer; box-shadow: 0 4px 18px rgba(99, 102, 241, 0.45); transition: transform 0.2s, box-shadow 0.2s; text-decoration: none; }
    .btn-hero-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(99, 102, 241, 0.6); }
    .ysign-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; padding: 2.5rem 1.25rem 3rem; max-width: 580px; margin: 0 auto; }
    .setup-card { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1.5px solid rgba(255, 255, 255, 0.08); border-radius: var(--r-xl); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25); padding: 2.5rem 2rem; transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); position: relative; overflow: hidden; }
    [data-theme="dark"] .setup-card { background: rgba(15, 17, 26, 0.65); border: 1.5px solid rgba(255, 255, 255, 0.05); }
    .setup-card::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(99, 102, 241, 0.08) 0%, transparent 60%); opacity: 0; transition: opacity 0.5s ease; z-index: 0; pointer-events: none; }
    .setup-card.ksign-card::before { background: radial-gradient(circle, rgba(236, 72, 153, 0.08) 0%, transparent 60%); }
    .setup-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(99, 102, 241, 0.15); border-color: rgba(99, 102, 241, 0.35); }
    .setup-card.ksign-card:hover { box-shadow: 0 20px 40px rgba(236, 72, 153, 0.15); border-color: rgba(236, 72, 153, 0.35); }
    .setup-card:hover::before { opacity: 1; }
    .setup-card > * { position: relative; z-index: 1; }
    .setup-title { font-size: 1.25rem; font-weight: 750; color: var(--label); margin-bottom: 1.8rem; letter-spacing: -0.02em; border-bottom: 1.5px solid var(--sep); padding-bottom: 0.8rem; display: flex; align-items: center; gap: 0.5rem; }
    .dl-badge-wrap { display: flex; gap: 0.6rem; justify-content: center; margin-bottom: 2rem; }
    .dl-badge { font-size: 0.78rem; font-weight: 700; padding: 0.4rem 0.85rem; border-radius: var(--r-pill); letter-spacing: 0.02em; transition: all 0.3s ease; background: rgba(99, 102, 241, 0.08); color: #6366f1; border: 1px solid rgba(99, 102, 241, 0.2); }
    .ksign-card .dl-badge { background: rgba(236, 72, 153, 0.08); color: #ec4899; border: 1px solid rgba(236, 72, 153, 0.2); }
    .setup-card:hover .dl-badge { transform: translateY(-2px) scale(1.03); box-shadow: 0 4px 10px rgba(99, 102, 241, 0.12); }
    .setup-card.ksign-card:hover .dl-badge { box-shadow: 0 4px 10px rgba(236, 72, 153, 0.12); }
    .btn-submit-install { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; font-size: 1.05rem; font-weight: 800; width: 100%; padding: 0.95rem 1.8rem; border-radius: var(--r-pill); border: none; cursor: pointer; box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3); transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
    .btn-submit-install:hover:not(:disabled) { transform: translateY(-3px) scale(1.02); box-shadow: 0 8px 30px rgba(99, 102, 241, 0.5); }
    .btn-submit-install.btn-ksign { background: linear-gradient(135deg, #ec4899, #8b5cf6); box-shadow: 0 4px 20px rgba(236, 72, 153, 0.3); }
    .btn-submit-install.btn-ksign:hover:not(:disabled) { box-shadow: 0 8px 30px rgba(236, 72, 153, 0.5); }
    .btn-input-action { background: var(--accent); color: #fff; font-weight: 700; font-size: 0.82rem; padding: 0 1.2rem; border-radius: var(--r-m); border: none; cursor: pointer; transition: background 0.2s, transform 0.15s; white-space: nowrap; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(99, 102, 241, 0.25); }
    .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(8px); z-index: 1000; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
    .modal-overlay.show { opacity: 1; pointer-events: auto; }
    .modal-card { background: var(--bg2); border: 1px solid var(--sep); border-radius: var(--r-xl); box-shadow: var(--sh-m); width: 90%; max-width: 440px; padding: 2.2rem 1.8rem; text-align: center; transform: scale(0.9); transition: transform 0.3s; }
    .modal-overlay.show .modal-card { transform: scale(1); }
    .modal-icon { width: 54px; height: 54px; background: rgba(16, 185, 129, 0.12); color: #10b981; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1.2rem; }
    .modal-title { font-size: 1.2rem; font-weight: 800; color: var(--label); margin-bottom: 0.6rem; }
    .modal-desc { font-size: 0.88rem; color: var(--label2); line-height: 1.5; margin-bottom: 1.8rem; }
    .btn-modal-close { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; font-weight: 700; font-size: 0.9rem; padding: 0.78rem 2rem; border-radius: var(--r-pill); border: none; cursor: pointer; width: 100%; max-width: 180px; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); }
  </style>

  <svg style="display:none" xmlns="http://www.w3.org/2000/svg">
    <symbol id="ico-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
      stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12" />
    </symbol>
    <symbol id="ico-device" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
      stroke-linecap="round" stroke-linejoin="round">
      <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
      <line x1="12" y1="18" x2="12.01" y2="18" />
    </symbol>
  </svg>

  <Navbar />

  <main>
    <section class="ysign-hero" id="install-hero">
      <div class="ysign-hero-inner">
        <h1>
          <span class="lang-vi">Tải ESign &amp; KSign iPA</span>
          <span class="lang-en" style="display:none">Download ESign &amp; KSign iPA</span>
        </h1>
        <p>
          <span class="lang-vi">Tải file cài đặt ESign và KSign iPA sạch, an toàn và mới nhất về thiết bị để ký ứng dụng
            iOS trực tiếp trên điện thoại của bạn!</span>
          <span class="lang-en" style="display:none">Download clean, secure, and the latest ESign &amp; KSign iPA files
            to sign and sideload iOS apps directly on your device!</span>
        </p>
        <a href="#setup-grid" class="btn-hero-cta">
          <span class="lang-vi">Tải xuống iPA ngay</span>
          <span class="lang-en" style="display:none">Download iPA Now</span>
        </a>
      </div>
    </section>

    <div class="ysign-grid" id="setup-grid">
      <section class="setup-card" aria-labelledby="setup-header"
        style="text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2.5rem 1.8rem;">
        <img src="/img/pf/profile-pic.png" alt="ESign Logo"
          style="width: 90px; height: 90px; border-radius: 20px; box-shadow: 0 8px 24px rgba(99, 102, 241, 0.25); margin-bottom: 1.2rem; border: 3px solid rgba(255, 255, 255, 0.1); animation: bouncePulse 3s ease-in-out infinite;" />
        <h2 class="setup-title" id="setup-header"
          style="border-bottom: none; margin-bottom: 0.5rem; padding-bottom: 0; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; display: flex; align-items: center; gap: 0.5rem; justify-content: center;">
          ESign iOS Sideload
        </h2>
        <p style="font-size: 0.88rem; color: var(--label2); margin-bottom: 1.5rem; line-height: 1.5; max-width: 320px;">
          <span class="lang-vi">Nhấp vào nút bên dưới để tải trực tiếp file cài đặt ESign iPA sạch, an toàn về thiết bị
            của bạn.</span>
          <span class="lang-en" style="display:none">Click the button below to download the clean, secure ESign iPA
            configuration file directly to your device.</span>
        </p>
        <div class="dl-badge-wrap" style="margin-bottom: 1.8rem; display: flex; gap: 0.5rem; justify-content: center;">
          <div class="dl-badge">v5.0.2</div>
          <div class="dl-badge">~12.4 MB</div>
          <div class="dl-badge">iOS 12.0+</div>
        </div>
        <button id="installBtn" class="btn-submit-install" onclick="directDownloadIPA()"
          style="max-width: 320px; font-weight: 800; letter-spacing: 0.02em; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span class="lang-vi">TẢI BẢN IPA (iOS)</span>
          <span class="lang-en" style="display:none">DOWNLOAD IPA (iOS)</span>
        </button>
        <div style="width: 100%; max-width: 320px; margin-top: 1.2rem;">
          <a href="https://muacert.com" target="_blank" class="btn-input-action"
            style="width: 100%; font-weight: 700; height: 42px; font-size: 0.88rem; background: linear-gradient(135deg, #10b981, #059669); text-decoration: none; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25); display: flex; align-items: center; justify-content: center; border-radius: var(--r-pill);">
            <span class="lang-vi">Mua chứng chỉ tại muacert.com</span>
            <span class="lang-en" style="display:none">Buy certificate at muacert.com</span>
          </a>
        </div>
      </section>

      <section class="setup-card ksign-card" aria-labelledby="ksign-header"
        style="text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2.5rem 1.8rem;">
        <img src={KS_IMG} alt="KSign Logo"
          style="width: 90px; height: 90px; border-radius: 20px; box-shadow: 0 8px 24px rgba(99, 102, 241, 0.25); margin-bottom: 1.2rem; border: 3px solid rgba(255, 255, 255, 0.1); animation: bouncePulse 3s ease-in-out infinite; animation-delay: 1.5s;" />
        <h2 class="setup-title" id="ksign-header"
          style="border-bottom: none; margin-bottom: 0.5rem; padding-bottom: 0; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; display: flex; align-items: center; gap: 0.5rem; justify-content: center;">
          KSign iOS Sideload
        </h2>
        <p style="font-size: 0.88rem; color: var(--label2); margin-bottom: 1.5rem; line-height: 1.5; max-width: 320px;">
          <span class="lang-vi">Nhấp vào nút bên dưới để tải trực tiếp file cài đặt KSign iPA sạch, an toàn về thiết bị
            của bạn.</span>
          <span class="lang-en" style="display:none">Click the button below to download the clean, secure KSign iPA
            configuration file directly to your device.</span>
        </p>
        <div class="dl-badge-wrap" style="margin-bottom: 1.8rem; display: flex; gap: 0.5rem; justify-content: center;">
          <div class="dl-badge">v1.5.1</div>
          <div class="dl-badge">~8.6 MB</div>
          <div class="dl-badge">iOS 16+</div>
        </div>
        <button id="ksignBtn" class="btn-submit-install btn-ksign" onclick="directDownloadKSign()"
          style="max-width: 320px; font-weight: 800; letter-spacing: 0.02em; display: flex; align-items: center; justify-content: center; gap: 0.5rem; background: linear-gradient(135deg, #8b5cf6, #ec4899); box-shadow: 0 4px 18px rgba(139, 92, 246, 0.4);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span class="lang-vi">TẢI BẢN IPA (iOS)</span>
          <span class="lang-en" style="display:none">DOWNLOAD IPA (iOS)</span>
        </button>
        <div style="width: 100%; max-width: 320px; margin-top: 1.2rem;">
          <a href="https://muacert.com" target="_blank" class="btn-input-action"
            style="width: 100%; font-weight: 700; height: 42px; font-size: 0.88rem; background: linear-gradient(135deg, #10b981, #059669); text-decoration: none; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25); display: flex; align-items: center; justify-content: center; border-radius: var(--r-pill);">
            <span class="lang-vi">Mua chứng chỉ tại muacert.com</span>
            <span class="lang-en" style="display:none">Buy certificate at muacert.com</span>
          </a>
        </div>
      </section>
    </div>
  </main>

  <div id="statusModal" class="modal-overlay" onclick="closeModal()">
    <div class="modal-card" onclick="event.stopPropagation()">
      <div class="modal-icon">
        <svg width="26" height="26" style="vertical-align:middle; fill:none; stroke:currentColor;">
          <use href="#ico-check"></use>
        </svg>
      </div>
      <h3 class="modal-title">
        <span class="lang-vi">Yêu Cầu Đã Gửi Thành Công!</span>
        <span class="lang-en" style="display:none">Request Submitted Successfully!</span>
      </h3>
      <p class="modal-desc" id="modalText"></p>
      <button class="btn-modal-close" onclick="closeModal()">OK</button>
    </div>
  </div>

  <Footer />

  <script is:inline>
    function directDownloadIPA() {
      window.location.href = "https://files.catbox.moe/z6n5sw.ipa";
    }
    function directDownloadKSign() {
      window.location.href = "https://github.com/Nyasami/Ksign/releases/download/v1.5.1/Ksign.ipa";
    }
    function closeModal() {
      document.getElementById("statusModal").classList.remove("show");
    }
  </script>
</BaseLayout>
