---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CertList from '../components/CertList.astro';
import { certs } from '../data/certs.js';
---

<BaseLayout
  title="Vũ Văn Khơi (khoindvn) - iOS Certificates, ESign & KSign Official"
  description="Official website of Vũ Văn Khơi (khoindvn). Download free iOS certificates, ESign, KSign. Trang web chính chủ của Vũ Văn Khơi web vuvankhoi.com là web giả mạo Fake"
  keywords="khoindvn, vuvankhoi, esign, ksign, apple certificate, ios certificates, sideload ios, chứng chỉ ios, kho ipa, sideloading tools"
  canonical="https://khoindvn.io.vn/"
  ads={true}
  appCss={true}
>
  <Fragment slot="head">
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="dmca-site-verification" content="bVJESUtHbW93QWxxWFEwN3VsNDRFQT090" />
    <meta property="og:site_name" content="Khơindvn" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Vũ Văn Khơi x Khoindvn",
      "url": "https://khoindvn.io.vn/",
      "logo": "https://khoindvn.io.vn/img/pf/profile-pic.png",
      "sameAs": [
        "https://t.me/+SpFewJb4liUwODM1",
        "https://discord.gg/cQjuP9TEp3"
      ]
    })} />
  </Fragment>

  <svg style="display:none" xmlns="http://www.w3.org/2000/svg">
    <symbol id="ico-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
      stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6" />
    </symbol>
  </svg>

  <Navbar />

  <main>

    <!-- HERO -->
    <section class="hero" id="about" aria-labelledby="hero-name">
      <div class="hero-inner">
        <img class="hero-avatar" src="https://khoindvn.io.vn/img/pf/profile-pic.png" alt="Avatar Vũ Văn Khơi"
          loading="eager" decoding="async" />

        <h1 class="hero-name" id="hero-name">
          Vũ Văn Khơi
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" aria-label="Verified"
            style="vertical-align:middle;flex-shrink:0;">
            <circle cx="12" cy="12" r="12" fill="#1877f2" />
            <polyline points="6,12 10,16 18,8" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
        </h1>

        <p class="hero-typing">
          <span id="typed-text"></span><span class="cursor">|</span>
        </p>

        <p class="hero-desc">
          <span class="lang-vi">Mua chứng chỉ <strong>ESign / KSign</strong> cài app 100% thành công chỉ
            <strong>50k</strong> —</span>
          <span class="lang-en" style="display:none">Buy <strong>ESign / KSign</strong> certificates for 100% successful
            app install only <strong>$2</strong> —</span>
          <a href="https://muacert.com" target="_blank" rel="noopener">muacert.com</a>
        </p>

        <div class="social-buttons" aria-label="Mạng xã hội"></div>
      </div>
    </section>

    <!-- LINKS -->
    <span class="section-label" id="links">
      <span class="lang-vi">Dịch vụ &amp; Liên kết</span>
      <span class="lang-en" style="display:none">Services &amp; Links</span>
    </span>

    <div class="links-section">
      <div class="links-card">

        <a class="link-row" href="https://muacert.com" target="_blank" rel="noopener">
          <span class="link-icon-wrap" style="background:#fff3e0;">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke="#f57c00" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" />
              <line x1="3" y1="6" x2="21" y2="6" stroke="#f57c00" stroke-width="1.8" />
              <path d="M16 10a4 4 0 01-8 0" stroke="#f57c00" stroke-width="1.8" stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          </span>
          <span class="link-label">
            <span class="lang-vi">Website Bán Chứng Chỉ – 50k</span>
            <span class="lang-en" style="display:none">Certificate Store – $2</span>
          </span>
          <span class="link-open-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </span>
        </a>

        <a class="link-row" href="https://t.me/+7bbn-Bk1RCk2NTQ9" target="_blank" rel="noopener">
          <span class="link-icon-wrap" style="background:#e3f2fd;">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M21.8 2.2L1.4 10c-1.3.5-1.3 1.3-.2 1.6l5.2 1.6 1.9 5.9c.3.8.4 1 1 1 .5 0 .7-.2 1-.6l2.5-2.4 5.2 3.8c1 .5 1.7.3 1.9-.9l3.4-16c.4-1.5-.5-2.2-1.5-1.8z"
                fill="#2196f3" />
              <path d="M8.8 13.4l.4 4.6 2.3-2.2-2.7-2.4z" fill="#1565c0" />
            </svg>
          </span>
          <span class="link-label"
            style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center; line-height: 1.3; white-space: normal;">
            <span style="font-weight: 600;">Telegram Notification Channel</span>
            <span class="lang-vi"
              style="font-size: 0.8rem; color: var(--label2); margin-top: 2px; font-weight: 500;">Kênh thông báo
              Telegram</span>
          </span>
          <span class="link-open-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </span>
        </a>

        <a class="link-row" href="https://t.me/GroupChatKhoindvn" target="_blank" rel="noopener">
          <span class="link-icon-wrap" style="background:#e8f5e9;">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="#43a047" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="link-label"
            style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center; line-height: 1.3; white-space: normal;">
            <span style="font-weight: 600;">Group Chat Telegram</span>
            <span class="lang-vi"
              style="font-size: 0.8rem; color: var(--label2); margin-top: 2px; font-weight: 500;">Nhóm chat
              Telegram</span>
          </span>
          <span class="link-open-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </span>
        </a>

        <a class="link-row" href="https://discord.gg/cQjuP9TEp3" target="_blank" rel="noopener">
          <span class="link-icon-wrap" style="background:#ede7f6;">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M20.3 4.4A19.7 19.7 0 0015.3 3c-.2.4-.5.9-.7 1.3a18.3 18.3 0 00-5.3 0A13.2 13.2 0 008.7 3a19.7 19.7 0 00-5 1.4C1.4 9 .8 13.4 1 17.8a19.9 19.9 0 006 3 14.9 14.9 0 001.3-2.1 12.9 12.9 0 01-2-.9l.5-.4a14.2 14.2 0 0012.3 0l.5.4a12.9 12.9 0 01-2 1 14.9 14.9 0 001.3 2c2.1-.6 4.1-1.6 6-3 .3-4.9-.8-9.3-3.6-13.4zM8.5 15.2c-1.1 0-2-1-2-2.3s.9-2.3 2-2.3 2 1 2 2.3-.9 2.3-2 2.3zm7 0c-1.1 0-2-1-2-2.3s.9-2.3 2-2.3 2 1 2 2.3-.9 2.3-2 2.3z"
                fill="#7c4dff" />
            </svg>
          </span>
          <span class="link-label"
            style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center; line-height: 1.3; white-space: normal;">
            <span style="font-weight: 600;">Join Discord Server</span>
            <span class="lang-vi"
              style="font-size: 0.8rem; color: var(--label2); margin-top: 2px; font-weight: 500;">Tham gia máy chủ
              Discord</span>
          </span>
          <span class="link-open-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </span>
        </a>

        <a class="link-row"
          href="https://github.com/dns-khoindvn/oci-auto-vm/releases/download/DNS/khoindvn.mobileconfig" target="_blank"
          rel="noopener">
          <span class="link-icon-wrap" style="background:#e0f7fa;">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="9" stroke="#0097a7" stroke-width="1.8" />
              <path d="M2 12h20M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20" stroke="#0097a7" stroke-width="1.8"
                stroke-linecap="round" />
            </svg>
          </span>
          <span class="link-label"
            style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center; line-height: 1.3; white-space: normal;">
            <span style="font-weight: 600;">Download DNS Profile (Required)</span>
            <span class="lang-vi"
              style="font-size: 0.8rem; color: var(--label2); margin-top: 2px; font-weight: 500;">Tải xuống Cấu hình DNS
              (Bắt buộc)</span>
          </span>
          <span class="link-open-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
          </span>
        </a>

        <a class="link-row" href="/install/" target="_blank" rel="noopener">
          <span class="link-icon-wrap" style="background:#f3e8ff;">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" stroke="#8b5cf6" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" />
              <polyline points="7 10 12 15 17 10" stroke="#8b5cf6" stroke-width="1.8" stroke-linecap="round"
                stroke-linejoin="round" />
              <line x1="12" y1="15" x2="12" y2="3" stroke="#8b5cf6" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </span>
          <span class="link-label"
            style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center; line-height: 1.3; white-space: normal;">
            <span style="font-weight: 600;">Download ESign &amp; KSign iPA</span>
            <span class="lang-vi"
              style="font-size: 0.8rem; color: var(--label2); margin-top: 2px; font-weight: 500;">Tải ESign &amp; KSign iPA</span>
          </span>
          <span class="link-open-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
          </span>
        </a>
      </div>
    </div>

    <div class="seg-wrap" id="bypass" role="tablist" aria-label="Chọn loại chứng chỉ">
      <div class="seg-track">
        <div class="seg-thumb" id="seg-thumb"></div>
        <button class="seg-btn active" id="tab-esign" role="tab" aria-selected="true" aria-controls="panel-esign"
          onclick="switchTab('esign')">ESign</button>
        <button class="seg-btn" id="tab-ksign" role="tab" aria-selected="false" aria-controls="panel-ksign"
          onclick="switchTab('ksign')">KSign</button>
      </div>
    </div>

    <div id="panel-esign" role="tabpanel" aria-labelledby="tab-esign" class="tab-panel">
      <div class="apps-wrap">
        <div class="esign-section"><CertList items={certs.esign} /></div>
      </div>
    </div>
    <div id="panel-ksign" role="tabpanel" aria-labelledby="tab-ksign" class="tab-panel" hidden>
      <div class="apps-wrap">
        <div class="ksign-section"><CertList items={certs.ksign} /></div>
      </div>
    </div>

    <!-- SKILLS -->
    <span class="section-label" id="skills">
      <span class="lang-vi">Kỹ năng</span>
      <span class="lang-en" style="display:none">Skills</span>
    </span>

    <section class="skills-section" aria-labelledby="skills-h">
      <div class="skills-card">
        <h2 id="skills-h">
          <span class="lang-vi">Kỹ năng Lập trình</span>
          <span class="lang-en" style="display:none">Programming Skills</span>
        </h2>
        <div class="skill-row">
          <span class="skill-name">HTML/CSS</span>
          <div class="skill-track">
            <div class="skill-fill" data-percent="76%" style="background:#e34c26"></div>
          </div>
          <span class="skill-pct">76%</span>
        </div>
        <div class="skill-row">
          <span class="skill-name">Lua</span>
          <div class="skill-track">
            <div class="skill-fill" data-percent="68%" style="background:#1f5af9"></div>
          </div>
          <span class="skill-pct">68%</span>
        </div>
        <div class="skill-row">
          <span class="skill-name">PHP</span>
          <div class="skill-track">
            <div class="skill-fill" data-percent="12%" style="background:#89a5f3"></div>
          </div>
          <span class="skill-pct">12%</span>
        </div>
        <div class="skill-row">
          <span class="skill-name">MySQL</span>
          <div class="skill-track">
            <div class="skill-fill" data-percent="9%" style="background:#f29111"></div>
          </div>
          <span class="skill-pct">9%</span>
        </div>
      </div>
    </section>

    <!-- LEGAL LINKS -->
    <div
      style="text-align: center; margin: 3rem 0 1.5rem; display: flex; justify-content: center; flex-wrap: wrap; gap: 0.8rem; align-items: center;">
      <a href="/tnc/"
        style="color: var(--muted, #888); text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.2s;">
        <span class="lang-vi">Điều khoản và Điều kiện</span><span class="lang-en" style="display:none">Terms &
          Conditions</span>
      </a>
      <span style="color: var(--border, #444);">|</span>
      <a href="/tos/"
        style="color: var(--muted, #888); text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.2s;">
        <span class="lang-vi">Thỏa thuận người dùng</span><span class="lang-en" style="display:none">User
          Agreement</span>
      </a>
      <span style="color: var(--border, #444);">|</span>
      <a href="/privacy/"
        style="color: var(--muted, #888); text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.2s;">
        <span class="lang-vi">Chính sách Bảo mật</span><span class="lang-en" style="display:none">Privacy Policy</span>
      </a>
    </div>

    <!-- DISCLAIMER -->
    <span class="section-label" id="disclaimer">
      <span class="lang-vi">Miễn trừ trách nhiệm</span>
      <span class="lang-en" style="display:none">Disclaimer</span>
    </span>
    <div style="padding: 0 1.5rem 2rem; max-width: 800px; margin: 0 auto;">
      <div
        style="background: var(--bg-card, #1c1e26); border: 1px solid var(--border, #2a2d3a); border-radius: 12px; padding: 1.5rem; color: var(--text-main, #fff); font-size: 0.95rem; line-height: 1.6; text-align: justify; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
        <p class="lang-vi" style="margin: 0;">
          <strong style="color: #ef4444;">Lưu ý:</strong> Toàn bộ thông tin, ứng dụng và chứng chỉ (nếu có) trên website
          này chỉ được cung cấp vì mục đích giáo dục, học tập và trải nghiệm cá nhân. Chúng tôi <b>KHÔNG</b> khuyến
          khích việc vi phạm bản quyền dưới bất kỳ hình thức nào. Người dùng khi sử dụng website tự chịu hoàn toàn trách
          nhiệm trước pháp luật về mọi rủi ro, tổn thất hoặc vấn đề bản quyền phát sinh từ việc tải xuống và cài đặt.
          Chúng tôi từ chối mọi trách nhiệm liên quan đến hành vi và mục đích sử dụng của bạn.
        </p>
        <p class="lang-en" style="margin: 0; display: none;">
          <strong style="color: #ef4444;">Note:</strong> All information, applications, and certificates (if any) on
          this website are provided solely for educational, learning, and personal experience purposes. We <b>DO NOT</b>
          encourage copyright infringement in any form. Users bear full legal responsibility for any risks, losses, or
          copyright issues arising from downloading and installing. We disclaim all liability related to your actions
          and intended use.
        </p>
      </div>
    </div>

  </main>

  <Footer />
</BaseLayout>
