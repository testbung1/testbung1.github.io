---
// Navbar dùng chung. Prop `home` quyết định link trỏ tới mục trong trang chủ.
// Dùng đường dẫn tuyệt đối từ root nên hoạt động ở mọi trang.
const links = [
  { href: '/#about', vi: 'Trang chủ', en: 'Home' },
  { href: '/#links', vi: 'Dịch vụ', en: 'Services' },
  { href: '/#bypass', vi: 'ESign / KSign', en: 'ESign / KSign' },
  { href: '/#skills', vi: 'Kỹ năng', en: 'Skills' },
  { href: '/tos/', vi: 'Thỏa thuận', en: 'ToS' },
  { href: '/tnc/', vi: 'Điều khoản', en: 'Terms' },
];
---

<header>
  <nav class="navbar" aria-label="Chính">
    <a href="/" class="nav-logo">khoindvn</a>

    <ul class="nav-links" id="nav-links">
      {links.map((l) => (
        <li>
          <a href={l.href}>
            <span class="lang-vi">{l.vi}</span>
            <span class="lang-en" style="display:none">{l.en}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-right">
      <button id="langBtn" class="color-mode" aria-label="Chuyển ngôn ngữ"
        style="font-weight: 800; font-size: 0.9rem; margin-right: 0.2rem; width: auto; padding: 0 0.5rem;"
        onclick="toggleLang()">VI</button>
      <button id="themeBtn" class="color-mode" aria-label="Chuyển chế độ màu" onclick="toggleTheme()">
        <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
      </button>

      <button id="menu-button" class="menu-button" aria-label="Mở menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
          aria-hidden="true" width="22" height="22">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </nav>
</header>
