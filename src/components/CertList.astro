---
// Render một danh sách chứng chỉ (ESign hoặc KSign) tại thời điểm build.
// Thay cho renderAppRow/renderList trong app.js cũ — không cần JS phía client.
export interface Props {
  items: { name: string; url: string; img: string; descriptions: string }[];
}
const { items } = Astro.props;
---

{items.map((item) => (
  <a href={item.url} class="app-row" target="_blank" rel="noopener">
    <img src={item.img} class="app-icon" alt={item.name} loading="lazy" />
    <div class="app-text">
      <div class="app-title">{item.name}</div>
      <div class="app-sub">{item.descriptions}</div>
    </div>
    <div class="app-action">
      <span class="lang-vi">CÀI ĐẶT</span>
      <span class="lang-en" style="display:none">INSTALL</span>
    </div>
  </a>
))}
